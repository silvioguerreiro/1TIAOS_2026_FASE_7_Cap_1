# =====================================================================
# .env.example — FarmTech Solutions (Fase 7) — Grupo 1TIAO
# Copie para ".env" e preencha. NÃO versione o .env (está no .gitignore).
# Tudo aqui tem default seguro: o projeto roda mesmo sem preencher nada.
# =====================================================================

# --- Banco de dados ---------------------------------------------------
# sqlite (padrão, portátil) | oracle (precisa de oracledb + VPN/credenciais)
DB_BACKEND=sqlite
# Usado apenas se DB_BACKEND=oracle:
ORACLE_USER=
ORACLE_PWD=
ORACLE_DSN=oracle.fiap.com.br:1521/ORCL

# --- API meteorológica (Fase 1) --------------------------------------
# open-meteo (padrão, SEM chave) | owm (OpenWeatherMap, precisa de chave)
METEO_PROVIDER=open-meteo
OWM_API_KEY=
# Localização da fazenda (default: Sorriso/MT)
FAZENDA_NOME=Fazenda Modelo - Sorriso/MT
FAZENDA_LAT=-12.5453
FAZENDA_LON=-55.7110

# --- AWS / Mensageria SNS (Fase 7) -----------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ARN do tópico SNS que entrega e-mail (e/ou SMS) aos funcionários:
SNS_TOPIC_ARN=
# Destinatários:
EMAIL_DEST=funcionario@fazenda.com.br
PHONE_DEST=+5511999999999
# Força modo simulado mesmo com credenciais (útil p/ demo/vídeo offline):
ALERTA_SIMULADO=false

# --- Logging ----------------------------------------------------------
LOG_LEVEL=INFO
